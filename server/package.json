  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.8"
  }
}
