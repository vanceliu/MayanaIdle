{
  "name": "mayana-server",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "gen:maps": "node scripts/genMapsIndex.mjs",
    "build": "node scripts/genMapsIndex.mjs && node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "node scripts/genMapsIndex.mjs && tsc -p tsconfig.json",
